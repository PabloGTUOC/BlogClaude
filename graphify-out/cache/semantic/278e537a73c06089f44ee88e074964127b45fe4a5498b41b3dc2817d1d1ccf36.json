{"nodes": [{"id": "readme_md_enderthoughts_app", "label": "Enderthoughts Application Spec", "file_type": "document", "source_file": "README.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_md_tech_stack", "label": "Technology Stack", "file_type": "rationale", "source_file": "README.md", "source_location": "line 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vue 3 + Vite + Vue Router + Pinia frontend; Node.js + Express.js backend; MySQL 8 database; Firebase Auth (Google OAuth); sharp for image processing; Nginx reverse proxy; Docker Compose. Images built on Apple Silicon must use --platform linux/amd64 for x86 deployment target."}, {"id": "readme_md_roles_access", "label": "Roles and Access Control", "file_type": "rationale", "source_file": "README.md", "source_location": "line 21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three roles: admin, user, public. New users start as pending and require admin approval. Admin role can only be set directly in MySQL \u2014 no self-registration path to admin. Approved users get different permissions per zone."}, {"id": "readme_md_public_zone", "label": "Public Zone", "file_type": "concept", "source_file": "README.md", "source_location": "line 66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_md_analog_zone", "label": "Analog Zone", "file_type": "concept", "source_file": "README.md", "source_location": "line 79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_md_digital_zone", "label": "Digital Zone", "file_type": "concept", "source_file": "README.md", "source_location": "line 109", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_md_admin_panel", "label": "Admin Panel Zone", "file_type": "concept", "source_file": "README.md", "source_location": "line 148", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_md_database_schema", "label": "Database Schema", "file_type": "document", "source_file": "README.md", "source_location": "line 188", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_md_image_pipeline", "label": "Image Upload Pipeline", "file_type": "rationale", "source_file": "README.md", "source_location": "line 313", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multer memoryStorage receives file buffer, exifr extracts EXIF, sharp resizes to max 2400px (quality 85) for full and max 400px (quality 80) for thumbnail. Both paths stored in photos table. Upload debouncing prevents double-POST."}, {"id": "readme_md_firebase_auth", "label": "Firebase Authentication", "file_type": "rationale", "source_file": "README.md", "source_location": "line 29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google OAuth only via Firebase SDK on frontend. Frontend sends Firebase ID token to POST /api/auth/firebase; backend verifies with Firebase Admin SDK, creates/finds user, returns custom JWT with role. Frontend reads JWT role and routes: pending\u2192/waiting, approved\u2192full access, revoked\u2192error+logout."}, {"id": "readme_md_google_photos_integration", "label": "Google Photos Picker Integration", "file_type": "rationale", "source_file": "README.md", "source_location": "line 140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OAuth2 scope photoslibrary.readonly. Frontend authenticates via Google OAuth popup; selected photos fetched server-side using access token (backend proxies download to avoid CORS). Downloaded, sharp-resized, and stored like direct uploads."}, {"id": "readme_md_monthly_gallery_conflict", "label": "Monthly Gallery Conflict Behaviour", "file_type": "rationale", "source_file": "README.md", "source_location": "line 122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each calendar month has at most one gallery enforced by UNIQUE constraint on year_month. On 409 conflict, frontend silently redirects to existing gallery \u2014 no error shown. From user perspective it just works."}, {"id": "readme_md_project_structure", "label": "Project Directory Structure", "file_type": "document", "source_file": "README.md", "source_location": "line 327", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_md_enderthoughts_app", "target": "design_md_enderthoughts_design_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 1", "weight": 1.0}, {"source": "readme_md_enderthoughts_app", "target": "readme_md_tech_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 11", "weight": 1.0}, {"source": "readme_md_enderthoughts_app", "target": "readme_md_roles_access", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 21", "weight": 1.0}, {"source": "readme_md_enderthoughts_app", "target": "readme_md_public_zone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 66", "weight": 1.0}, {"source": "readme_md_enderthoughts_app", "target": "readme_md_analog_zone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 79", "weight": 1.0}, {"source": "readme_md_enderthoughts_app", "target": "readme_md_digital_zone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_locatio