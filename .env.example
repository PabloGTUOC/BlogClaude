# ============================================================
# ENDERTHOUGHTS // CONFIGURATION SCHEMAS
# ============================================================

# --- DATABASE CONFIGURATIONS ---
DB_HOST=db
DB_PORT=3306
DB_NAME=enderthoughts
# Least-privilege app user (must NOT be 'root' — the mysql image refuses to
# create MYSQL_USER=root). Auto-created with grants on DB_NAME, but ONLY when
# the mysql-data volume is fresh; on an existing volume create it manually:
#   CREATE USER 'enderthoughts'@'%' IDENTIFIED BY '<DB_APP_PASS>';
#   GRANT ALL PRIVILEGES ON enderthoughts.* TO 'enderthoughts'@'%';
DB_USER=enderthoughts
# MySQL root password (container admin only — the app never uses root)
DB_PASS=secret_root_password_1984
# Password for the DB_USER app account (what the API connects with)
DB_APP_PASS=secret_app_password_1984

# --- SECURITY SYSTEM ---
# REQUIRED — the API refuses to start without it (no insecure fallback).
# Generate with: openssl rand -hex 32
JWT_SECRET=provide_a_secure_long_jwt_secret_key
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
# The API refuses to start if Firebase credentials are missing/invalid, UNLESS this is
# set to 'true' (and NODE_ENV is not 'production'). Mock mode accepts ANY token as a
# valid login — strictly for local development.
# ALLOW_MOCK_AUTH=true

# --- GOOGLE PHOTOS PICKER API (BACKEND OAUTH) ---
# Server-side secret used to exchange the OAuth code for an access token.
# Found in Google Cloud Console > Credentials > your OAuth 2.0 Client ID.
GOOGLE_CLIENT_SECRET=GOCSPX-your_oauth_client_secret
# Public base URL of the API server. Used to build the OAuth redirect URI:
#   <API_ORIGIN>/api/digital/google-photos/callback
# This EXACT redirect URI must be registered in Cloud Console > Credentials.
# Production is SINGLE-ORIGIN: the frontend nginx proxies /api + /uploads to the
# api container, so both origins are the same public site URL.
# Local dev: http://localhost:3000   Production: https://blog.enderthoughts.com
API_ORIGIN=http://localhost:3000
# Public base URL of the frontend (used for origin checks / CORS).
# Local dev: http://localhost:5173   Production: https://blog.enderthoughts.com
FRONTEND_ORIGIN=http://localhost:5173

# --- MEDIA PIPELINE ---
# Host bind mount directory for processed image/video output (full/ and thumbs/).
# Videos are stored as-is; poster thumbnails are generated via bundled ffmpeg
# (ffmpeg-static / ffprobe-static — no system ffmpeg install required).
# Production example: /srv/enderthoughts/uploads   Local dev: ./uploads
UPLOAD_PATH=/srv/enderthoughts/uploads

# --- SMTP TRANSMISSION (ALERT MAILER) ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=smtp_password
ADMIN_EMAIL=operator@enderthoughts.com

# --- FRONTEND COMPILER ENVS (VITE) ---
# Local dev: http://localhost:3000/api   Production: https://blog.enderthoughts.com/api
VITE_API_BASE_URL=http://localhost:3000/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Firebase Client SDK Configuration Keys (these are public values, not secrets)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
